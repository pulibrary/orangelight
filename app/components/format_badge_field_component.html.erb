<ul class="lux format-badge-group">
  <% if @field.document.physical_holding?%>
    <li>
      <lux-badge color="yellow"><%= render DecorativeAccessIconComponent.new "Physical" %>
        Physical
      </lux-badge>
  <% end %>
  <% if @field.document.electronic_access?%>
    <li>
      <lux-badge color="<%= online_color %>"><%= render DecorativeAccessIconComponent.new "Online" %>
        Online
      </lux-badge>
  <% end %>
</ul>
