<%= simple_form_for(form, url: contact_missing_item_path, remote: true, html: { id: 'missing_item_form' }) do |f| %>
  <%= f.label :name %><br>
  <%= f.input_field :name %><br>
  <%= f.label :email %><br>
  <%= f.input_field :email %><br>
  <%= f.label :message %><br>
  <%= f.input_field :message, as: :text, style: "width: 100%" %><br>
  <%= f.input :context, as: :hidden %>
  <%= f.input :title, as: :hidden %>
  <div class="visually-hidden">
    <%= f.label :feedback_desc %>
    <%= f.input_field :feedback_desc %>
  </div>
  <% if local_assigns.fetch(:render_actions, true) %>
    <%= f.submit "Send", class: "btn btn-primary" %>
  <% end %>
<% end %>
