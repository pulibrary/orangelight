{
  "packages": {
    "ruby":                     "4.0.10",
    "bundler":                  "latest",
    "nodejs":                   "26.7.0",
    "yarn":                     "1.22.22",
    "git":                      "latest",
    "zsh":                      "latest",
    "pkg-config":               "latest",
    "postgresql":               {"version": "latest", "outputs": ["out", "lib", "dev"]},
    "libyaml":                  {"version": "latest", "outputs": ["out", "dev"]},
    "zlib":                     {"version": "latest", "outputs": ["out", "dev"]},
    "libffi":                   {"version": "latest", "outputs": ["out", "dev"]},
    "openssl":                  {"version": "latest", "outputs": ["out", "dev"]},
    "path:flakes/solr#default": {},
    "libxml2":                  {"version": "latest", "outputs": ["out", "dev"]},
    "libxslt":                  {"version": "latest", "outputs": ["out", "dev"]},
    "redis":                    "latest",
    "nodePackages.yalc":        "latest"
  },
  "env": {
    "LANG": "C.UTF-8",
    "PATH": "$PWD/node_modules/.bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "echo 'devbox: orangelight environment ready (run `devbox run shell` for zsh)'"
    ],
    "scripts": {
      "shell": [
        "exec zsh"
      ],
      "setup": [
        "test -f \"$PGDATA/PG_VERSION\" || initdb",
        "bundle install",
        "yarn install",
        "devbox run create_solr_collections"
      ],
      "rebuild-gems": [
        "bundle pristine"
      ],
      "deploy": [
        "bundle exec cap production deploy"
      ],
      "deploy-staging": [
        "bundle exec cap staging deploy"
      ],
      "dev": [
        "devbox run setup",
        "bundle exec rake db:migrate",
        "bundle exec rails s"
      ],
      "test": [
        "devbox run setup",
        "RAILS_ENV=test bundle exec rake db:migrate",
        "bundle exec rspec"
      ],
      "create_solr_collections": [
        "[ $(curl -s -o /dev/null -w '%{http_code}' http://localhost:${SOLR_PORT:-8983}/solr/orangelight-core-dev/admin/ping) -eq '200' ] || solr create_core -c orangelight-core-dev -d solr/conf -p ${SOLR_PORT:-8983}",
        "[ $(curl -s -o /dev/null -w '%{http_code}' http://localhost:${SOLR_PORT:-8983}/solr/orangelight-core-test/admin/ping) -eq '200' ] || solr create_core -c orangelight-core-test -d solr/conf -p ${SOLR_PORT:-8983}"
      ],
      "delete_solr_collections": [
        "curl -X POST http://localhost:${SOLR_PORT:-8983}/api/cores/orangelight-core-dev/unload -H 'Content-Type: application/json' -d '{\"deleteIndex\":true,\"deleteDataDir\":true,\"deleteInstanceDir\":true}' || echo 'orangelight-core-dev core was already deleted'",
        "curl -X POST http://localhost:${SOLR_PORT:-8983}/api/cores/orangelight-core-test/unload -H 'Content-Type: application/json' -d '{\"deleteIndex\":true,\"deleteDataDir\":true,\"deleteInstanceDir\":true}' || echo 'orangelight-core-test core was already deleted'"
      ],
      "recreate_solr_collections": [
        "devbox run delete_solr_collections",
        "devbox run create_solr_collections"
      ]
    }
  }
}
