{
  "packages": {
    "ruby":       "3.4.8",
    "bundler":    "latest",
    "nodejs":     "26.7.0",
    "yarn":       "1.22.10",
    "git":        "latest",
    "openssh":    "latest",
    "zsh":        "latest",
    "pkg-config": "latest",
    "postgresql": {"version": "latest", "outputs": ["out", "lib", "dev"]},
    "libyaml":    {"version": "latest", "outputs": ["out", "dev"]},
    "zlib":       {"version": "latest", "outputs": ["out", "dev"]},
    "libffi":     {"version": "latest", "outputs": ["out", "dev"]},
    "openssl":    {"version": "latest", "outputs": ["out", "dev"]},
    "path:flakes/solr#default": {}
  },
  "env": {
    "LANG": "C.UTF-8",
    "PATH": "$PWD/node_modules/.bin:$PATH"
  },
  "shell": {
    "init_hook": [
      "echo 'devbox: orangelight environment ready (run `devbox run shell` for zsh)'"
    ],
    "scripts": {
      "shell": [
        "exec zsh"
      ],
      "setup": [
        "test -f \"$PGDATA/PG_VERSION\" || initdb",
        "bundle install",
        "yarn install"
      ],
      "rebuild-gems": [
        "bundle pristine"
      ],
      "deploy": [
        "bundle exec cap production deploy"
      ],
      "deploy-staging": [
        "bundle exec cap staging deploy"
      ],
      "dev": [
        "devbox run setup",
        "bundle exec rake db:migrate",
        "bundle exec rails s"
      ],
      "test": [
        "devbox run setup",
        "RAILS_ENV=test bundle exec rake db:migrate",
        "bundle exec rspec"
      ]
    }
  }
}
